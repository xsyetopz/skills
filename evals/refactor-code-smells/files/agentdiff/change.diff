+class ClientLookupHelper:
+    def __init__(self, store: CustomerStore):
+        self.store = store
+
+    def get_client(self, client_id: str):
+        try:
+            return self.store.fetch(client_id, retries=3)
+        except Exception:
+            return None
+
+
+def invoice_total(
+    store: CustomerStore,
+    client_id: str,
+    net_cents: int,
+) -> int:
+    client = ClientLookupHelper(store).get_client(client_id)
+    if client is None:
+        return net_cents
+    rate = 0 if client.get("tax_exempt") else 20
+    return net_cents + net_cents * rate // 100

