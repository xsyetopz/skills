{
	"description": "Harmless project hook validation fixture.",
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup|resume",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$(git rev-parse --show-toplevel)/.agent-hooks/observe.py\"",
						"timeout": 5,
						"statusMessage": "Checking hook transport"
					}
				]
			}
		]
	}
}
