<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
  <extension point="org.eclipse.ui.commands">
    <command
        id="__PLUGIN_ID__.commands.encodeFormValue"
        name="Encode Selection as Form Value" />
  </extension>
  <extension point="org.eclipse.ui.handlers">
    <handler
        class="__JAVA_PACKAGE__.EncodeFormValueHandler"
        commandId="__PLUGIN_ID__.commands.encodeFormValue">
      <activeWhen>
        <with variable="activeEditor">
          <instanceof value="org.eclipse.ui.texteditor.ITextEditor" />
        </with>
      </activeWhen>
    </handler>
  </extension>
  <extension point="org.eclipse.ui.menus">
    <menuContribution locationURI="menu:org.eclipse.ui.main.menu?after=additions">
      <command
          commandId="__PLUGIN_ID__.commands.encodeFormValue"
          label="Encode Selection as Form Value"
          style="push" />
    </menuContribution>
  </extension>
</plugin>
