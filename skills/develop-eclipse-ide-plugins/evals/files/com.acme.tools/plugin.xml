<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
  <extension point="org.eclipse.ui.commands">
    <command id="com.acme.tools.trimTrailing" name="Trim Trailing Whitespace"/>
  </extension>
  <extension point="org.eclipse.ui.handlers">
    <handler commandId="com.acme.tools.trimTrailing"
        class="com.acme.tools.TrimTrailingHandler"/>
  </extension>
  <extension point="org.eclipse.ui.menus">
    <menuContribution locationURI="menu:edit?after=additions">
      <command commandId="com.acme.tools.trimTrailing" style="push"/>
    </menuContribution>
  </extension>
</plugin>
