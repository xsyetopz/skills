<idea-plugin>
  <id>org.acme.search</id>
  <name>Acme Search</name>
  <vendor email="dev@acme.invalid">Acme</vendor>
  <description><![CDATA[Searches Acme symbols across the project.]]></description>
  <depends>com.intellij.modules.platform</depends>
  <actions>
    <action id="org.acme.search.SearchSymbols"
            class="org.acme.search.SearchSymbolsAction"
            text="Search Acme Symbols">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
