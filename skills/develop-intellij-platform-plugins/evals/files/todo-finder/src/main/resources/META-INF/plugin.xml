<idea-plugin>
  <id>org.acme.todofinder</id>
  <name>TODO Finder</name>
  <vendor email="dev@acme.invalid">Acme</vendor>
  <description><![CDATA[Counts TODO comments in Kotlin files.]]></description>
  <depends>com.intellij.modules.platform</depends>
  <actions>
    <action id="org.acme.todofinder.FindTodos"
            class="org.acme.todofinder.FindTodosAction"
            text="Count TODOs in Project">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
