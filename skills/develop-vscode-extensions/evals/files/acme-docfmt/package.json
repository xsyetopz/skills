{
	"name": "acme-docfmt",
	"displayName": "Acme Doc Format",
	"description": "Normalizes headings in Acme documentation files.",
	"version": "0.3.1",
	"publisher": "acme",
	"license": "MIT",
	"engines": {
		"vscode": "^1.88.0"
	},
	"categories": [
		"Formatters"
	],
	"main": "./out/extension.js",
	"activationEvents": [],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"commands": [
			{
				"command": "acmeDocfmt.formatDocument",
				"title": "Acme Doc: Normalize Headings"
			}
		]
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@types/vscode": "^1.88.0",
		"typescript": "^5.6.0"
	}
}
