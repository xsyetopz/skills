{
  "name": "fixture-root",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "fixture-root",
      "workspaces": [
        "packages/*"
      ],
      "dependencies": {
        "native-dep": "file:./native-dep"
      }
    },
    "native-dep": {
      "version": "1.0.0",
      "hasInstallScript": true
    },
    "node_modules/@fixture/app": {
      "resolved": "packages/app",
      "link": true
    },
    "node_modules/@fixture/util": {
      "resolved": "packages/util",
      "link": true
    },
    "node_modules/native-dep": {
      "resolved": "native-dep",
      "link": true
    },
    "packages/app": {
      "name": "@fixture/app",
      "version": "1.0.0",
      "dependencies": {
        "@fixture/util": "1.0.0"
      }
    },
    "packages/util": {
      "name": "@fixture/util",
      "version": "1.0.0"
    }
  }
}
