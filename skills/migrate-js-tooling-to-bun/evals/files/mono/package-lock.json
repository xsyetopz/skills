{
	"name": "acme-mono",
	"lockfileVersion": 3,
	"requires": true,
	"packages": {
		"": {
			"name": "acme-mono",
			"workspaces": [
				"packages/*"
			],
			"devDependencies": {
				"codegen": "file:./tools/codegen"
			}
		},
		"node_modules/@acme/app": {
			"resolved": "packages/app",
			"link": true
		},
		"node_modules/@acme/util": {
			"resolved": "packages/util",
			"link": true
		},
		"node_modules/codegen": {
			"resolved": "tools/codegen",
			"link": true
		},
		"packages/app": {
			"name": "@acme/app",
			"version": "1.0.0",
			"dependencies": {
				"@acme/util": "1.0.0"
			}
		},
		"packages/util": {
			"name": "@acme/util",
			"version": "1.0.0"
		},
		"tools/codegen": {
			"version": "0.1.0",
			"dev": true,
			"hasInstallScript": true
		}
	}
}
